# Copy to .env next to compose.yaml and fill in.

# --- Compose ---
TORII_IMAGE_OWNER=your-github-user
TORII_TAG=latest
TORII_PORT=8080

# --- App ---
APP_NAME=Torii
APP_ENV=production
APP_DEBUG=false
# Generate: echo "base64:$(openssl rand -base64 32)"
APP_KEY=
APP_URL=http://nas.local:8080
LOG_CHANNEL=stderr
LOG_LEVEL=info

# --- Database (the bundled `db` service) ---
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=torii
DB_USERNAME=torii
DB_PASSWORD=change-me

QUEUE_CONNECTION=database
CACHE_STORE=database
SESSION_DRIVER=database

# --- Feed ---
FEED_URL=https://subsplease.org/rss/?r=1080
FEED_POLL_BASE_MINUTES=15

# --- qBittorrent ---
# Use the NAS LAN IP, not localhost: "localhost" inside a container is the container itself.
QBIT_URL=http://192.168.1.10:8080
QBIT_USERNAME=
QBIT_PASSWORD=
QBIT_FEED_PATH=SubsPlease 1080p
QBIT_CATEGORY=Anime
QBIT_RULE_PREFIX="[ST] "
QBIT_TAG=subtracker
