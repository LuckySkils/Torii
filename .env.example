# qBittorrent WebUI: use the NAS LAN IP, not localhost
QBIT_URL=http://192.168.1.10:8080
# Leave empty if qBittorrent skips login for Docker's network
QBIT_USERNAME=
QBIT_PASSWORD=
# Category for downloads (case-sensitive, must match qBittorrent)
QBIT_CATEGORY=Anime

# Optional
TORII_PORT=8080
APP_URL=http://192.168.1.10:8080
DB_PASSWORD=torii

# Optional: ntfy push notifications (leave NTFY_URL empty to disable)
NTFY_URL=
NTFY_TOPIC=torii
NTFY_TOKEN=
NOTIFY_NEW_EPISODE=true
NOTIFY_DOWNLOADED=true
NOTIFY_REPACKS=false
NOTIFY_CLICK_URL=
