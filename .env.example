# ---- qBittorrent ----
# WebUI address. On the same host as Torii, use the host's LAN IP, not localhost.
QBIT_URL=http://192.168.1.10:8080
# Leave both empty if qBittorrent bypasses auth for Docker's network (172.16.0.0/12)
QBIT_USERNAME=
QBIT_PASSWORD=
# Category for downloads (case-sensitive, must exist in qBittorrent)
QBIT_CATEGORY=Anime

# ---- Torii ----
APP_NAME=Torii
TORII_PORT=8080
# Address you open Torii at (reverse-proxy URL if you use one)
APP_URL=http://192.168.1.10:8080
# Where the database, app key and ntfy data are stored on the host
TORII_DATA_DIR=./data
DB_PASSWORD=torii
# SubsPlease's feed timestamps run this many minutes off UTC; try -480 if release
# times look an hour off after US daylight saving ends in November.
#FEED_PUBDATE_OFFSET_MINUTES=-420

# ---- Notifications (optional) ----
# Remove these lines to run without notifications.
#COMPOSE_PROFILES=notifications
#NTFY_URL=http://ntfy:80
#NTFY_TOPIC=torii
#NTFY_TOKEN=
#NTFY_BASE_URL=http://192.168.1.10:8081
#NTFY_PORT=8081
#NOTIFY_CLICK_URL=

# ---- MCP server (optional) ----
# Lets an LLM client (Claude Code, Claude Desktop) read Torii's catalog, schedule
# and shows over the Model Context Protocol. See "MCP server" in the README.
#MCP_ENABLED=true
# Empty: served at /mcp on TORII_PORT. Set: its own port, published only with
# COMPOSE_FILE=docker-compose.yml:docker-compose.mcp.yml (Windows: use ;).
#MCP_PORT=7099
#COMPOSE_FILE=docker-compose.yml:docker-compose.mcp.yml
# Bearer token; when set, every MCP request needs it. Set one before exposing MCP.
#MCP_TOKEN=
# true also offers track/untrack/queue/download tools, which start downloads.
#MCP_ALLOW_WRITES=false
#MCP_MAX_RESULTS=50

# ---- Nyaa import (optional) ----
# Trackers added to magnets built from a Nyaa RSS import, comma-separated.
# Empty: Torii's defaults.
#NYAA_TRACKERS=
